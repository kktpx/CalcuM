# Copy this file to `.env` and fill in the values. `.env` is git-ignored; never commit it.
#
# Supabase dashboard -> Project Settings -> API
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
# "anon" / "public" key only. NEVER put the service_role key here:
# EXPO_PUBLIC_* values are bundled into the app and readable by anyone.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Do NOT add the Gemini API key here (sub-project 4). It is set as a Supabase
# secret for the Edge Function instead: `supabase secrets set GEMINI_API_KEY=...`
